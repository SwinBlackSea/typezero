LISTEN_ADDR=:8080
DASHSCOPE_API_KEY=replace-me
DEEPSEEK_API_KEY=replace-me

# Optional overrides
QWEN_ASR_MODEL=qwen3-asr-flash
QWEN_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_API_URL=https://api.deepseek.com/chat/completions
PROVIDER_TIMEOUT=120s
REQUEST_TIMEOUT=140s
# Token-bucket rate limit (requests/min). Keep high enough that all chunks
# of one dictation session pass in a single burst.
REQUESTS_PER_MINUTE=60
# Max concurrent upstream ASR calls. The project account queues when two
# calls overlap (one waited 90s and timed out), so default is serial.
ASR_CONCURRENCY=1
# Accuracy-first delayed hedge: start Groq only when Qwen is still pending
# after 2s, keep Qwen priority until 16s, then cancel it and use Groq.
# Requires GROQ_API_KEY and may bill both providers on slow Qwen requests.
ASR_HEDGE=0
ASR_HEDGE_DELAY=2s
QWEN_RESULT_DEADLINE=16s
# DashScope queues burst requests for up to this long instead of returning
# 429 immediately (official X-DashScope-Wait-Timeout). 0 disables queueing.
QWEN_WAIT_TIMEOUT=30s

# ASR provider: qwen (DashScope) or groq (Groq Whisper).
# Groq runs at roughly real-time or faster; Qwen is the fallback.
SPEECH_PROVIDER=qwen
GROQ_API_KEY=
GROQ_MODEL=whisper-large-v3
GROQ_API_URL=https://api.groq.com/openai/v1
# Whole-file upload is the production strategy. Keep this at 0: recordings
# through 120s use Qwen-first hedging; longer recordings go directly to Groq.
# NOTE: once server-config.json exists (written via POST /config from the
# client settings), it takes precedence over SPEECH_PROVIDER/CHUNK_SECONDS.
CHUNK_SECONDS=0
# Groq Whisper auto-detects the audio language (no language field is
# sent), so Chinese and mixed Chinese/English audio are both transcribed
# without forcing a fixed language or prompt.
# ASR comparison mode: transcribe every chunk with both providers and write
# speed + raw transcripts to ASR_COMPARE_FILE (JSONL). For testing only;
# transcripts land in the file by design, never in server.log.
ASR_COMPARE=0
ASR_COMPARE_FILE=/tmp/asr_compare.jsonl
